<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <!-- Measured on the packaged app: without allow-jit V8 cannot reserve its code range on arm64, and with library
       validation on an ad hoc signed app cannot load Electron's own framework. allow-unsigned-executable-memory is
       what Electron documents V8 needing on Intel; it was not needed on arm64 and no Intel Mac has measured it. -->
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
