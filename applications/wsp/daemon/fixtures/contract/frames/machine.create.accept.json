[
  {
    "id": 1,
    "op": "machine.create",
    "spec": {
      "kind": "sandbox",
      "template": "wsp-box:24.04",
      "cpu": 2,
      "memMb": 4096,
      "diskGb": 20,
      "envs": {
        "A": "b"
      },
      "labels": {
        "wsp": "1"
      },
      "onIdle": "pause",
      "idleTimeoutMs": 1800000,
      "idempotencyKey": "k1",
      "engine": true,
      "copy": {
        "from": "/wsp/projects/wsp/checkout",
        "at": "/Users/zingzy/wsp"
      },
      "shares": [
        {
          "source": "/var/lib/wsp/logins/codex/auth.json",
          "target": "/root/.codex/auth.json"
        }
      ],
      "binds": [
        {
          "source": "/wsp/projects/pr_1/memory",
          "target": "/root/.claude-cfg/projects/-root-wsp/memory"
        }
      ]
    }
  },
  {
    "id": 2,
    "op": "machine.create",
    "spec": {
      "kind": "desktop"
    }
  },
  {
    "id": 3,
    "op": "machine.create",
    "spec": {
      "kind": "sandbox",
      "binds": [
        {
          "source": "/wsp/projects/pr_1/checkout",
          "target": "/Users/zingzy/wsp",
          "readOnly": true
        }
      ]
    }
  }
]
