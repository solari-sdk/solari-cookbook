{
  "name": "wsp",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "node scripts/hooks-path.mjs",
    "test": "vitest run",
    "build": "pnpm -r build",
    "wsp": "node packages/host/dist/bin.js",
    "release": "pnpm --filter @zingzy/wsp release",
