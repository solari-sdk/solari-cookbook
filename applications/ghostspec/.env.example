# Required. The cloud browser ghostspec explores and verifies on.
# Free key at https://console.getsolari.com
SOLARI_API_KEY=slr_live_...

# Optional. Without it, ghostspec uses the `claude` CLI already on your PATH,
# so anyone running Claude Code needs no second key.
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional. Overrides the model used for exploration and codegen.
# Default: claude-sonnet-5
GHOSTSPEC_MODEL=
