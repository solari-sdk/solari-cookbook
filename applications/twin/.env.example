# Solari settings. Exported variables win; otherwise twin reads these two from the nearest .env
# above the working directory (only these two: a .env never leaks into captured environments).
# Required for replay, bisect, verify, list, shell, stop and mcp. capture and inspect need nothing.
SOLARI_API_KEY=slr_live_...
# Optional: gateway override, defaults to https://api.getsolari.com
SOLARI_BASE_URL=
# Optional, environment only: set to any value to disable colored output (https://no-color.org)
NO_COLOR=
# Optional, environment only: set to force colored output when the stream is not a terminal
FORCE_COLOR=
