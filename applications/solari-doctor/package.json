{
  "name": "solari-doctor",
  "version": "0.1.0",
  "description": "Deterministic diagnostic CLI for documented Solari configuration, SDK-version, lifecycle, and resource-cleanup problems.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "solari-doctor": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@solarisdk/browser": "^0.1.3",
    "@solarisdk/sandbox": "^0.1.3",
    "@solarisdk/sdk": "^0.1.3"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "eslint": "10.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0"
  }
}
