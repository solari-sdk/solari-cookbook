# solari-doctor: every dependency is project-local.
# Never `npm install -g` for this project — see CLAUDE.md.

# Pin exact versions: a diagnostic tool must be reproducible.
save-exact=true

# Do not run package install scripts (arbitrary code on install).
# Override deliberately per-command if a package genuinely needs a build step.
ignore-scripts=true

# Fail loudly if Node is older than a package requires (SDK needs >= 20).
engine-strict=true

fund=false
