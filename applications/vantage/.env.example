# Only server-side secret. Pays for the managed browser.
SOLARI_API_KEY=slr_live_...

# Model keys are NOT set here — users bring their own in the UI
# (Claude / OpenAI / Gemini), and they are never stored server-side.

# Absolute origin used for canonical URLs and social share cards.
# Social crawlers reject relative image paths, so set this on deploy.
# NEXT_PUBLIC_SITE_URL=https://vantage.example.com
