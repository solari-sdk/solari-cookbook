# Solari API key, from https://console.getsolari.com
SOLARI_API_KEY=
# Where candidates and reviewers open their links. `pnpm run new` prints links with it.
# Development: the Vite dev server on 3100. Production: this server's own address.
PUBLIC_URL=http://localhost:3100
# Port for `pnpm start` in production. `pnpm run dev:api` always uses 3101.
PORT=3000
# Turns on the interviewer page at /admin, where interviews and their links are made.
# Use a long random value, for example the output of: openssl rand -base64 24
ADMIN_TOKEN=
# Machines your Solari plan allows at once. The free plan allows 1. Rooms beyond
# this wait instead of failing.
MAX_ROOMS=1
# A public "Try it" demo on the home page, for a hosted copy. Off unless "on".
# Each demo spends credit, so it runs one at a time and is capped per 24 hours.
DEMO=off
# The task folder under tasks/ that demos use.
DEMO_TASK=lru-cache
DEMO_DAILY_LIMIT=20
DEMO_WORK_MINUTES=10
DEMO_SETUP_MINUTES=3
# Where Interview records, recordings and final states are kept. Defaults to ./data.
# On a host, point this at a persistent volume.
DATA_DIR=
