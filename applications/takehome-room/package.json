{
  "name": "takehome-room",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev:api": "PORT=3101 tsx watch --env-file-if-exists=.env src/main.ts",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "tsx --env-file-if-exists=.env src/main.ts",
    "new": "tsx --env-file-if-exists=.env src/cli.ts",
    "e2e": "tsx --env-file-if-exists=.env scripts/e2e.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit && pnpm --filter web typecheck",
    "sweep": "tsx --env-file-if-exists=.env scripts/sweep.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@solarisdk/desktop": "0.1.3",
    "@solarisdk/sandbox": "0.1.4",
    "hono": "^4.13.13",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^5.7.2"
  }
}
