From b95c5091ef60194ca82f0d1815e294c3c52c41c7 Mon Sep 17 00:00:00 2001
From: sanketsingh27 <singh.sanket27@gmail.com>
Date: Wed, 2 Sep 2026 16:44:19 +0530
Subject: [PATCH] PR C: add unrelated product filter

---
 package.json         |  1 +
 src/filter.js        | 15 +++++++++++++++
 tests/filter.test.js | 17 +++++++++++++++++
 3 files changed, 33 insertions(+)
 create mode 100644 src/filter.js
 create mode 100644 tests/filter.test.js

diff --git a/package.json b/package.json
index d8b72c8..d0305fd 100644
--- a/package.json
+++ b/package.json
@@ -15,6 +15,7 @@
   "devDependencies": {
     "@types/express": "^5.0.0",
     "@types/node": "^22.10.2",
+    "jsdom": "^25.0.1",
     "supertest": "^7.0.0",
     "typescript": "^5.7.2",
     "vite": "^6.0.3",
diff --git a/src/filter.js b/src/filter.js
new file mode 100644
index 0000000..a9c9975
--- /dev/null
+++ b/src/filter.js
@@ -0,0 +1,15 @@
+async function renderFilter() {
+  const products = ["Shirt", "Pants", "Shoes"];
+
+  let container = document.getElementById("filter");
+  if (!container) {
+    container = document.createElement("div");
+    container.id = "filter";
+    document.body.appendChild(container);
+  }
+
+  container.innerHTML = `<label>Filter: <input type="text" id="filter-input" /></label>
+    <ul>${products.map((p) => `<li>${p}</li>`).join("")}</ul>`;
+}
+
+renderFilter();
diff --git a/tests/filter.test.js b/tests/filter.test.js
new file mode 100644
index 0000000..7c48da9
--- /dev/null
+++ b/tests/filter.test.js
@@ -0,0 +1,17 @@
+import { describe, it, expect, beforeEach } from "vitest";
+import { JSDOM } from "jsdom";
+
+describe("product filter", () => {
+  beforeEach(() => {
+    const dom = new JSDOM(`<!DOCTYPE html><div id="filter"></div>`);
+    global.document = dom.window.document;
+  });
+
+  it("renders product list", async () => {
+    await import("../src/filter.js");
+    const el = document.getElementById("filter");
+    if (!el) throw new Error("Filter element not found");
+    expect(el.querySelectorAll("li").length).toBe(3);
+    expect(el.textContent).toContain("Shirt");
+  });
+});
-- 
