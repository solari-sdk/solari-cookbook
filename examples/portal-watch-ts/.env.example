# Get a key at https://console.getsolari.com
SOLARI_API_KEY=slr_live_...

# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional — any tool-use-capable Claude model works
CLAUDE_MODEL=claude-sonnet-5

# Optional — only needed if ANTHROPIC_API_KEY is an identity-linked key (tied
# to your account across multiple workspaces). Find it in your workspace
# settings at console.anthropic.com. A workspace-scoped key doesn't need this.
ANTHROPIC_WORKSPACE_ID=

# Optional — credentials the mock portal's fake login form accepts (any
# value works, it doesn't check them). Irrelevant once you point this at a
# real portal with a real login flow.
PORTAL_DEMO_USER=
PORTAL_DEMO_PASS=
