# Copy this file to .env.local and fill in your real values.
# .env* is gitignored — your key will never be committed.

# Solari SDK live API key (server-side only — never exposed to the client).
SOLARI_API_KEY=slr_live_your_key_here

# Toggle the live Solari API mode.
# - "false" (default): agent pipeline runs in fully simulated demo mode
# - "true": agent pipeline additionally POSTs to the real Solari API via /api/solari/run
SOLARI_LIVE_MODE=false

# Optional: override the Solari API base URL if you have a custom endpoint.
# SOLARI_API_BASE_URL=https://api.getsolari.com/v1
