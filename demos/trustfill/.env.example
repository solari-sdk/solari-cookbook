# Model provider — M0 and M1 need exactly one of these.
# OpenRouter has free models: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Solari — not needed until M2 (sandbox + browser).
# Get a key at https://console.getsolari.com
SOLARI_API_KEY=slr_live_...

# NVIDIA NIM — reasoning models. https://build.nvidia.com
NVIDIA_API_KEY=nvapi-...
