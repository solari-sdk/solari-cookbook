# Required. Boots the portal sandbox and drives the browser.
# Get a key at https://console.getsolari.com
SOLARI_API_KEY=slr_live_...

# Optional. Answers replay from committed fixtures, so no model key is needed
# unless you pass --live to scripts/fill.ts or regenerate fixtures with
# scripts/capture.ts.
NVIDIA_API_KEY=nvapi-...
# OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...
