        "cache.py": "class Cache:\n    def __init__(self):\n        self.store = {}\n        self.cached = {}\n\n    def put(self, key, value):\n        self.store[key] = value\n        self.cached.pop(key, None)\n\n    def get(self, key):\n        if key not in self.cached:\n            self.cached[key] = self.store.get(key)\n        return self.cached[key]\n\n    def delete(self, key):\n        self.store.pop(key, None)\n"
      },
      "candidate": {
