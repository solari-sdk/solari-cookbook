# Get a key at https://console.getsolari.com
# One key works for both sandboxes and browser sessions, billed to the
# same balance.
SOLARI_API_KEY=slr_live_...

# Signs the login session cookie. Any long random string — generate one
# with: openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-string

# Gates GET /api/admin and the /admin page.
ADMIN_SECRET=change-me
