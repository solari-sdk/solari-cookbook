{
    "compilerOptions": {
      "target": "ES2022",
      "module": "NodeNext",
      "moduleResolution": "NodeNext",
      "outDir": "dist",
      "rootDir": "src",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "types": ["node"]
    },
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "examples",
      "demo-app",
      "node_modules",
      "dist"
    ]
  }