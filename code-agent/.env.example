# Grab one at https://console.getsolari.com — one key works across
# browser, sandbox, and desktop, billed to the same balance.
SOLARI_API_KEY=slr_live_...

# --- AWS Bedrock (drives the agent's decisions via a Mistral model) -------
# Needs Bedrock model access enabled for a Mistral model in your account
# (AWS Console → Bedrock → Model access). Claude entitlement not required.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...

# Optional overrides
BEDROCK_MODEL_ID=mistral.mistral-large-3-675b-instruct
