{
  "name": "patchproof",
  "version": "0.1.0",
  "description": "Two-sided regression evidence from disposable Solari sandboxes",
  "type": "module",
  "private": true,
  "engines": { "node": ">=24" },
  "bin": { "patchproof": "dist/src/cli.js" },
  "files": ["dist/src", "guest/runner.py", "fixtures", "README.md", "LICENSE", "SECURITY.md"],
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:guest": "node scripts/test-guest.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc --noEmit",
    "demo": "node --experimental-strip-types src/cli.ts simulate fixtures/cache-fix.json",
    "demo:live": "node --env-file-if-exists=.env --experimental-strip-types src/cli.ts run fixtures/cache-fix.json"
  },
  "dependencies": { "@solarisdk/sandbox": "0.1.3" },
  "devDependencies": { "@types/node": "24.10.1", "typescript": "5.9.3" }
}
